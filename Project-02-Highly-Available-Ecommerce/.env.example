# Local development example only. Never add real credentials to this file.
NODE_ENV=development
PORT=3000
AWS_REGION=ap-south-1
DB_NAME=ecommerce
DB_HOST=replace-with-rds-endpoint
DB_CA_PATH=/path/to/global-bundle.pem
DB_SECRET_ARN=arn:aws:secretsmanager:ap-south-1:000000000000:secret:replace-me
ASSETS_BUCKET=ecommerce-prod-assets-replace-me
